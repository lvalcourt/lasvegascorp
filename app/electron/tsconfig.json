{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": false,
    "types": ["vite/client", "node"]
  },
  "include": [
    "renderer/src/**/*.ts",
    "renderer/src/**/*.vue",
    "renderer/src/**/*.d.ts",
    "src/**/*.ts"
  ]
}
