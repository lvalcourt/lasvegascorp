{
  "name": "lasvegarscorp-electron",
  "version": "0.1.0",
  "description": "Las Vegas Corp Payroll Tool desktop app",
  "private": true,
  "homepage": "https://example.com/lasvegarscorp",
  "author": {
    "name": "Las Vegas Corp",
    "email": "lvalcourt@autonomypr.com"
  },
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --out-extension:.js=.cjs --external:electron --outdir=dist",
    "build": "npm run build:renderer && npm run build:main",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vue": "^3.4.38",
    "vue-router": "^4.4.5",
    "vue-tsc": "^2.0.29"
  },
  "build": {
    "appId": "com.lasvegarscorp.payrolltool",
    "productName": "Las Vegas Corp Payroll Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "renderer-dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../python/dist",
        "to": "backend/dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../python/rules.json",
        "to": "backend/rules.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Las Vegas Corp <lvalcourt@autonomypr.com>"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    }
  }
}
